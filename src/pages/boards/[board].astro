---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, CATEGORIES, postSlug, fmtDate, type Category } from '../../lib/posts';

export async function getStaticPaths() {
  return (['study', 'thoughts'] as const).map((board) => ({ params: { board }, props: { board } }));
}

const { board } = Astro.props as { board: Exclude<Category, 'about'> };
const cat = CATEGORIES[board];
const posts = (await getPosts()).filter((p) => p.data.category === board);
---

<BaseLayout title={cat.name} description={cat.desc}>
  <div class="wrap">
    <nav class="crumbs" aria-label="面包屑">
      <a href="/">首页</a>
      <span aria-hidden="true">/</span>
      <span>{cat.name}</span>
    </nav>

    <header class="page-head">
      <p class="eyebrow">{cat.english.toUpperCase()}</p>
      <h1>{cat.name}</h1>
      <p class="lede">{cat.desc}</p>
      <p class="meta">{posts.length} 篇</p>
    </header>

    {posts.length === 0 ? (
      <p class="empty">这条枝还没有长出叶子。</p>
    ) : (
      <ul class="list">
        {posts.map((p) => (
          <li>
            <span class="meta date">{fmtDate(p.data.date)}</span>
            <a class="title" href={`/posts/${postSlug(p)}/`}>{p.data.title}</a>
            {p.data.summary && <span class="summary">{p.data.summary}</span>}
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 22px 80px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: var(--fs-meta);
    color: var(--text-muted);
    margin-bottom: 18px;
  }
  .crumbs a {
    color: var(--text-muted);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .page-head {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .page-head h1 {
    margin: 10px 0 10px;
    font-size: clamp(30px, 5vw, 42px);
  }
  .lede {
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.9;
    margin: 0 0 14px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .title {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.5;
  }
  .title:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .summary {
    grid-column: 2;
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-top: -6px;
  }
  .empty {
    padding: 40px 0;
    color: var(--text-muted);
  }
  @media (max-width: 600px) {
    .list li {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .summary {
      grid-column: 1;
    }
  }
</style>
