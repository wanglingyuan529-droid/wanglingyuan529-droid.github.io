---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, postSlug, fmtDate, CATEGORIES, relatedPosts } from '../../lib/posts';
import { render } from 'astro:content';
import { readingTimeMinutes, wordCount } from '../../lib/reading-time';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const all = await getPosts();
const related = relatedPosts(all, post);
const cat = CATEGORIES[post.data.category];
const minutes = readingTimeMinutes(post.body ?? '');
const words = wordCount(post.body ?? '');
---

<BaseLayout title={post.data.title} description={post.data.summary || post.data.title}>
  <article class="wrap">
    <nav class="crumbs" aria-label="面包屑">
      <a href="/">首页</a>
      <span aria-hidden="true">/</span>
      <a href={`/boards/${post.data.category}/`}>{cat.name}</a>
    </nav>

    <header class="post-head">
      <h1>{post.data.title}</h1>
      {post.data.summary && <p class="lede">{post.data.summary}</p>}
      <p class="meta post-meta">
        <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} 分钟</span>
        <span aria-hidden="true">·</span>
        <span>约 {words} 字</span>
        {post.data.pin && <span class="pin">置顶</span>}
      </p>
      {post.data.tags.length > 0 && (
        <p class="tags">
          {post.data.tags.map((t) => (
            <a class="tag" href={`/tags/${encodeURIComponent(t)}/`}>#{t}</a>
          ))}
        </p>
      )}
    </header>

    <div class="content-wrap">
      <div class="prose">
        <Content />
      </div>
      {headings.length > 0 && (
        <aside class="toc" aria-label="本文目录">
          <p class="eyebrow">CONTENTS</p>
          <ol>
            {headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>

    {related.length > 0 && (
      <section class="related">
        <p class="eyebrow">READ NEXT</p>
        <ul>
          {related.map((p) => (
            <li>
              <span class="meta">{fmtDate(p.data.date)}</span>
              <a href={`/posts/${postSlug(p)}/`}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="post-foot">
      <a href={`/boards/${post.data.category}/`}>← 回到「{cat.name}」</a>
      <a href="/posts/">全部笔记</a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .prose {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .prose h2 {
    margin: 2.2em 0 0.8em;
    font-size: 26px;
  }
  .prose h3 {
    margin: 1.8em 0 0.6em;
    font-size: 21px;
  }
  .prose h2 + p,
  .prose h3 + p {
    margin-top: 0;
  }
  .prose a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .prose a:hover {
    text-decoration-color: var(--accent);
  }
  .prose > :first-child {
    margin-top: 0;
  }
</style>

<style>
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 22px 72px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: var(--fs-meta);
    color: var(--text-muted);
    margin-bottom: 22px;
  }
  .crumbs a {
    color: var(--text-muted);
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .post-head {
    padding-bottom: 26px;
    border-bottom: 1px solid var(--border);
  }
  .post-head h1 {
    font-size: clamp(28px, 4.6vw, 40px);
    line-height: 1.35;
  }
  .lede {
    margin: 16px 0 0;
    font-size: 17px;
    color: var(--text-secondary);
    line-height: 1.9;
  }
  .post-meta {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin: 18px 0 0;
  }
  .post-meta time {
    color: var(--text-secondary);
  }
  .pin {
    color: var(--accent-3);
    border: 1px solid color-mix(in srgb, var(--accent-3) 40%, var(--border));
    border-radius: 999px;
    padding: 1px 9px;
    font-size: 12px;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin: 12px 0 0;
  }
  .tag {
    font-size: 12px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 1px 9px;
    text-decoration: none;
  }
  .tag:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    text-decoration: none;
  }
  .content-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    gap: 36px;
    padding-top: 32px;
  }
  .toc {
    position: sticky;
    top: 82px;
    align-self: start;
    font-size: 13px;
    line-height: 1.9;
    border-left: 1px solid var(--border);
    padding-left: 14px;
    max-height: 70vh;
    overflow-y: auto;
  }
  .toc ol {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }
  .toc .d3 {
    padding-left: 12px;
  }
  .toc a {
    color: var(--text-muted);
  }
  .toc a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .related {
    margin-top: 52px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }
  .related ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }
  .related li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 7px 0;
  }
  .related a {
    color: var(--text);
  }
  .related a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .post-foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: var(--fs-meta);
  }
  @media (max-width: 860px) {
    .content-wrap {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .toc {
      display: none;
    }
  }
</style>
