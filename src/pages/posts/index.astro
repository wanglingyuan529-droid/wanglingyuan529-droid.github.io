---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, CATEGORIES, postSlug, fmtDate } from '../../lib/posts';

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

<BaseLayout title="全部笔记" description="AinSoph 的全部学习笔记与随想，按时间倒序。">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">ALL NOTES</p>
      <h1>全部笔记</h1>
      <p class="meta">{posts.length} 篇 · 按时间倒序</p>
    </header>

    {posts.length === 0 ? (
      <p class="empty">还没有落笔。第一篇正在路上。</p>
    ) : (
      <ul class="timeline">
        {posts.map((post) => (
          <li>
            <a class="item" href={`/posts/${postSlug(post)}/`}>
              <span class="date meta">{fmtDate(post.data.date)}</span>
              <span class="body">
                <span class="title">{post.data.title}</span>
                {post.data.summary && <span class="summary">{post.data.summary}</span>}
                <span class="tags">
                  <span class="tag board-tag">{CATEGORIES[post.data.category].name}</span>
                  {post.data.tags.map((t) => <span class="tag">#{t}</span>)}
                </span>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 48px 22px 80px;
  }
  .page-head {
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 8px;
  }
  .page-head h1 {
    margin: 12px 0 10px;
    font-size: clamp(30px, 5vw, 40px);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline li {
    border-bottom: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
  }
  .item {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) 24px;
    gap: 16px;
    align-items: start;
    padding: 18px 10px 18px 4px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.18s ease;
  }
  .item:hover {
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    text-decoration: none;
  }
  .date {
    padding-top: 3px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 18px;
    color: var(--text);
    line-height: 1.5;
  }
  .summary {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.8;
  }
  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 2px;
  }
  .tag {
    font-size: 12px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 1px 9px;
  }
  .board-tag {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  }
  .arrow {
    color: var(--text-muted);
    opacity: 0;
    transition: opacity 0.18s ease;
    align-self: center;
  }
  .item:hover .arrow {
    opacity: 1;
    color: var(--accent);
  }
  .empty {
    padding: 40px 0;
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .item {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .date {
      padding-top: 0;
    }
    .arrow {
      display: none;
    }
  }
</style>
