---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 这条枝还没长出来" description="页面不存在。">
  <div class="wrap">
    <p class="code">404</p>
    <h1>这条枝还没长出来</h1>
    <p class="meta">你要找的页面不存在，或者已经被移走了。</p>
    <div class="actions">
      <a class="btn" href="/">回到首页</a>
      <a class="btn ghost" href="/posts/">看看全部笔记</a>
    </div>
  </div>
</BaseLayout>

<style>
  .wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 120px 22px;
    text-align: center;
  }
  .code {
    font-family: var(--font-mono);
    font-size: 64px;
    color: var(--accent);
    opacity: 0.5;
    margin: 0;
    line-height: 1;
  }
  h1 {
    margin: 20px 0 12px;
    font-size: clamp(26px, 4vw, 34px);
  }
  .meta {
    margin-bottom: 28px;
  }
  .actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    padding: 10px 22px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 15px;
    text-decoration: none;
  }
  .btn:hover {
    background: var(--accent-hover);
    color: var(--on-accent);
    text-decoration: none;
  }
  .btn.ghost {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--text-secondary);
  }
  .btn.ghost:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
